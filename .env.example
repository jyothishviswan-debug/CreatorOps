# CreatorOps local development defaults.
# Copy to .env.local. These values target the Firebase Emulator Suite only —
# never a live project. See `pnpm firebase:emulators`.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-creatorops.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-creatorops
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-creatorops.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demo
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

FIREBASE_PROJECT_ID=demo-creatorops
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Server-side Admin SDK. Only required outside emulator mode (production).
# Point this at a service-account JSON file kept outside version control
# (e.g. secrets/<project>-service-account.json, gitignored). Never commit
# the key file or paste its contents here.
GOOGLE_APPLICATION_CREDENTIALS=

# Finance Agreements: durable storage of the ORIGINAL signed Agreement PDF (Step 14B.1).
# The exact uploaded PDF is written to a Google Drive folder after the Agreement version is confirmed,
# using the service account above (GOOGLE_APPLICATION_CREDENTIALS), which must be an editor of both
# folders. Leave these blank and the app says "Drive storage not configured" (it never invents a link).
# The values below are the folder ids of the product owner's shared Agreement folders, shown as
# documented EXAMPLES - copy them into .env.local (never commit real credentials).
#   Partners folder: https://drive.google.com/drive/folders/1K8lBfs_n4N2TDwmgRjfFEHeciuH41e56
#   Vendors folder:  https://drive.google.com/drive/folders/17ml7p5D5n2L5P0jyEv1cqjxBK_PVkFrG
FINANCE_AGREEMENT_DRIVE_PARTNERS_FOLDER_ID=
FINANCE_AGREEMENT_DRIVE_VENDORS_FOLDER_ID=
# Example values (uncomment in .env.local to use the owner's folders):
# FINANCE_AGREEMENT_DRIVE_PARTNERS_FOLDER_ID=1K8lBfs_n4N2TDwmgRjfFEHeciuH41e56
# FINANCE_AGREEMENT_DRIVE_VENDORS_FOLDER_ID=17ml7p5D5n2L5P0jyEv1cqjxBK_PVkFrG
# DEV/TEST ONLY - uses an in-memory fake instead of Drive (fake links on https://drive.invalid/fake/...).
# Ignored when NODE_ENV=production. Used by the browser E2E run; never set it against real data.
# FINANCE_AGREEMENT_DRIVE_MODE=fake

# Password for the deterministic local Auth-emulator test users (see
# src/server/auth/seed-users.ts / `pnpm seed:emulator`). Emulator-only,
# never a real credential - set your own value in .env.local, never here.
EMULATOR_TEST_USER_PASSWORD=
