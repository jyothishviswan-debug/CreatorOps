# CreatorOps local development defaults.
# Copy to .env.local. These values target the Firebase Emulator Suite only —
# never a live project. See `pnpm firebase:emulators`.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-creatorops.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-creatorops
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-creatorops.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demo
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

FIREBASE_PROJECT_ID=demo-creatorops
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Server-side Admin SDK. Only required outside emulator mode (production).
# Point this at a service-account JSON file kept outside version control
# (e.g. secrets/<project>-service-account.json, gitignored). Never commit
# the key file or paste its contents here.
GOOGLE_APPLICATION_CREDENTIALS=
